# SEJFA current-state environment template
# Copy to .env and fill in your values: cp .env.example .env

# --- Runtime mode ---
# auto: use Linear when configured, otherwise fall back to the local demo workspace
# demo: force local demo tasks even if Linear is configured
# full: require Linear-backed task read/write
SEJFA_MODE=auto

# --- Remote inference on ai-server2 ---
WHISPER_BACKEND=remote
WHISPER_REMOTE_URL=http://<ai-server2>:8000
WHISPER_MODEL=small
WHISPER_DEVICE=auto

OLLAMA_URL=http://<ai-server2>:11434
OLLAMA_MODEL=qwen2.5-coder-helpful:3b
OLLAMA_TIMEOUT=120

# --- Linear task source of truth ---
LINEAR_API_URL=https://api.linear.app/graphql
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_TEAM_KEY=

# --- Optional OpenAI Whisper fallback ---
OPENAI_API_KEY=

# --- Ambiguity clarification loop ---
AMBIGUITY_THRESHOLD=0.3
MAX_CLARIFICATION_ROUNDS=3

# --- Ralph Loop queueing ---
# Recommended v1 default: review/save first, then manual /start-task.
AUTO_DISPATCH_LOOP=false
QUEUE_DB_PATH=loop_queue.db

# --- Voice pipeline app ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
LOG_LEVEL=INFO

# --- Local stack / desktop wiring (optional shell-level overrides) ---
# The local stack defaults to monitor :8110 and companion :8788.
# Standalone monitor defaults to :8100 and standalone companion defaults to :8787.
# SEJFA_MONITOR_API_URL=http://127.0.0.1:8110
# SEJFA_VOICE_URL=http://127.0.0.1:8000
# Required for desktop-facing local task/session APIs. start-sejfa-local.sh generates one automatically.
# SEJFA_LOCAL_API_TOKEN=replace-with-local-random-token
# VITE_SEJFA_VOICE_URL=http://127.0.0.1:8000
# VITE_SEJFA_MONITOR_URL=http://127.0.0.1:8110
# VITE_SEJFA_LOCAL_API_TOKEN=replace-with-local-random-token
